# Copy this file to .env for local development, but do not commit .env.

# OpenBMB's current public docs show an OpenAI-compatible /v1 endpoint.
# Use your own local environment value for the actual key.
IRIS_API_BASE_URL=https://api.modelbest.cn/v1
IRIS_MODEL=MiniCPM-V-4.6-Thinking
IRIS_API_KEY=

IRIS_TIMEOUT_SECONDS=60
IRIS_MAX_TOKENS=1000
IRIS_TEMPERATURE=0.25
